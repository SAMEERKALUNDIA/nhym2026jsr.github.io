{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nhymindia",
  "main": "worker.ts",
  "compatibility_date": "2026-09-30",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application" },
  "d1_databases": [
    { "binding": "DB", "database_name": "nhym2026-registration", "database_id": "28e5572f-dbf8-41d9-96cb-1a481cf5069b" }
  ],
  "r2_buckets": [
    {
      "binding": "GALLERY",
      "bucket_name": "nhym-gallery"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_id": "dfea51ad-0f55-422c-98a9-90f4f48eec6e"
      }
    ],
    "r2_buckets": [
      {
        "binding": "GALLERY",
        "bucket_name": "nhym-gallery-preview"
      }
    ]
  }
}
