{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nhymindia-dpdp-preview",
  "main": "worker.ts",
  "account_id": "1d5d70a7ee45b7c0c9b1f04aeb025924",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nhym2026-finance-preview",
      "database_id": "dfea51ad-0f55-422c-98a9-90f4f48eec6e"
    }
  ],
  "r2_buckets": [
    {
      "binding": "GALLERY",
      "bucket_name": "nhym-gallery-preview"
    }
  ],
  "vars": {
    "EMAIL_SERVICE_URL": "https://example.invalid",
    "FINANCE_PREVIEW_MODE": "true"
  }
}
